{
  "name": "golf-fpg",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-logos-gallery.js",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gallery": "node scripts/build-logos-gallery.js",
    "prebuild": "node scripts/build-logos-gallery.js",
    "build": "tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "login": "node scripts/login.js",
    "scrape": "node scripts/golf-all.js",
    "scorecards": "node scripts/make-scorecards-ui.js",
    "uskids:lookup:build": "node scripts/build-uskids-name-lookup.js",
    "uskids:lookup:apply": "node scripts/apply-lookup-names.js",
    "uskids:lookup:add-new": "node scripts/add-new-mids-from-lookup.js",
    "uskids:refresh": "node scripts/build-uskids-name-lookup.js && node scripts/apply-lookup-names.js && node scripts/add-new-mids-from-lookup.js && echo \"Pronto. Commita uskids-member-history-slim.json e o CI faz o resto.\""
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "html-to-image": "^1.11.13",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "playwright": "^1.59.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.4"
  }
}
